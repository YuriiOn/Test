# ---------------------------------------------------------------------------
# Tech Scout environment configuration
# Copy this file to `.env` and fill in your keys.
# ---------------------------------------------------------------------------

# GitHub personal access token (classic, no scopes needed for public data).
# Without a token you get 60 requests/hour; with one you get 5000/hour.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# YouTube Data API v3 key.
# Create at: https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" for the project first)
YOUTUBE_API_KEY=

# Anthropic API key for the LLM analysis pipeline.
# Create at: https://platform.claude.com/
# If omitted, the pipeline falls back to a built-in heuristic analyzer.
ANTHROPIC_API_KEY=

# Model used for the weekly analysis (optional).
ANTHROPIC_MODEL=claude-opus-4-8

# Where to keep the SQLite database and generated artifacts (optional).
TECHSCOUT_DB_PATH=data/techscout.db
TECHSCOUT_OUTPUT_DIR=output
